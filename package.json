{
  "name": "cellar",
  "productName": "Cellar",
  "version": "7.2.0",
  "description": "A Claude Desktop-style app for running local models.",
  "main": "./out/main/index.js",
  "author": "Cellar",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run runtime:artifacts && electron-vite dev",
    "build": "npm run runtime:artifacts && electron-vite build",
    "preview": "electron-vite preview",
    "runtime:artifacts": "node scripts/build-artifact-runtime.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@huggingface/gguf": "^0.4.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "croner": "^10.0.1",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "extract-zip": "^2.0.1",
    "jszip": "^3.10.2",
    "marked": "^18.0.13",
    "node-pty": "^1.1.0",
    "pptxgenjs": "^4.0.1",
    "pyright": "^1.1.414",
    "systeminformation": "^5.33.10",
    "typescript": "~5.9.3",
    "typescript-language-server": "^6.0.0",
    "unpdf": "^1.8.1",
    "vscode-jsonrpc": "^9.0.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/browser": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@types/node": "^24.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "^1.45.0",
    "monaco-editor": "^0.56.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vscode-languageserver-protocol": "^3.18.3",
    "zustand": "^5.0.15"
  }
}
